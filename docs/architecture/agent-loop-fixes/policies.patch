+// reservationSteps is the ownership rule shared by live mutation and replay.
+// Audit and repair children use scope but never own its reservation.
+func reservationSteps(w Work) []StepID {
+	if w.Kind != Implementation || w.State.Terminal() || w.Scope == nil {
+		return nil
+	}
+	return w.Scope.StepIDs
+}
+
+// replaceWork updates the work and its derived reservation index together.
+// Callers hold s.mu; this method does not publish or append mutation changes.
+func (s *Store) replaceWork(id ID, v Work) {
+	for _, step := range reservationSteps(s.works[id]) {
+		if s.reserved[step] == id {
+			delete(s.reserved, step)
+		}
+	}
+	v = v.Clone()
+	s.works[id] = v
+	for _, step := range reservationSteps(v) {
+		s.reserved[step] = id
+	}
+}
+
